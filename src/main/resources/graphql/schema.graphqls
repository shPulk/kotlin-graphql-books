type Author {
    id: ID!
    name: String!
    country: String
}

type Book {
    id: ID!
    title: String!
    pageCount: Int!
    author: Author!
}

type BookPage {
    content: [Book!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input AddBookInput {
    title: String!
    pageCount: Int!
    authorId: ID!
}

input UpdateBookInput {
    title: String
    pageCount: Int
    authorId: ID
}

type Query {
    books(page: Int = 0, size: Int = 10): BookPage!
    bookById(id: ID!): Book
    authors: [Author!]!
}

type Mutation {
    addBook(input: AddBookInput!): Book!
    updateBook(id: ID!, input: UpdateBookInput!): Book!
    deleteBook(id: ID!): Boolean!
}
